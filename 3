---
import { Image } from 'astro:assets';
import fotoJose from '../../assets/yo.jpg';
---

<div class=personalCard>
  <img src={fotoJose.src} alt="fotografia Jose Murillo"/>
  <div class=presentation>
    <div>
      <h1>Jose Alejandro Murillo Chevez</h1>
      <p>&lt;&gt; Desarollador &lt;/&gt;</p>
    </div>
  </div>
</div>

<style>
  .personalCard{
    width: 50%;
    display: flex;
    justify-content: center;
    position: relative;
  }
  img{
    height: 100%;
    z-index: 0;
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    -webkit-mask-image: linear-grandient(to bottom, black 60%, transparent 100%);
  }
  .presentation{
    position: absolute;
    justify-content: end;
    text-align: end;
    right: 0px;
    bottom: 0px;
    z-index: 1;
    h1{
      margin: 5px 10px 5px auto;
      font-size: 50px;
    }
    div{
      margin-left: auto;
      width: 70%;
      background-image: radial-gradient(circle at 100% 0%, rgba(30, 58, 138, 0.5) 0%, transparent 70%);
      border-radius: 10px;
    }
    p{
      font-weight: bold;
      margin:0 15px 0 0;
      font-size: 20px;
      color:cyan;
    }
  }
</style>
