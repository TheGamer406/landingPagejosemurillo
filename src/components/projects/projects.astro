---
// TODO: mover a una content collection cuando haya mas proyectos reales
const projects = [
  {
    title: 'Landing Page Portfolio',
    description: 'Sitio personal construido con Astro: blog, RSS y este mismo apartado de proyectos.',
    stack: ['Astro', 'TypeScript', 'MDX'],
    status: 'En desarrollo',
    href: 'https://github.com/TheGamer406',
  },
];
---

<!--capa fija: los cubos acompañan toda la pagina, no solo el hero-->
<div class="cubesFx" aria-hidden="true">
  <div class="cube"></div>
  <div class="cube"></div>
  <div class="cube"></div>
  <div class="cube"></div>
  <div class="cube"></div>
  <div class="cube"></div>
</div>

<div class="projectsHero">
  <div class="heroContent">
    <span class="devBadge">Vista previa</span>
    <h1>Proyectos</h1>
    <div class="line"></div>
    <p class="comment">Trabajo en curso &middot; se irán agregando proyectos aquí</p>
    <p class="scrollCue">Desliza para ver <span>&darr;</span></p>
  </div>
</div>

<!--listado de proyectos-->
<section class="projectsZone">

  <!--aviso explicito de que la pagina aun no es definitiva-->
  <div class="devNotice" role="status">
    <span class="devNoticeIcon" aria-hidden="true">&#9888;</span>
    <div>
      <strong>Esta pagina esta en desarrollo</strong>
      <p>
        Lo que ves es una vista previa. Los proyectos reales, sus capturas y sus
        enlaces llegaran en la siguiente version del portafolio.
      </p>
    </div>
  </div>

  <div class="projectsGrid">
    {projects.map((project) => (
      <a class="projectCard" href={project.href} target="_blank" rel="noopener noreferrer">
        <span class="status">{project.status}</span>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <ul class="stack">
          {project.stack.map((tech) => <li>{tech}</li>)}
        </ul>
      </a>
    ))}

    <!--tarjeta fija que indica que la seccion sigue en desarrollo-->
    <div class="projectCard placeholder">
      <span class="status">Próximamente</span>
      <h3>Más proyectos en camino</h3>
      <p>Esta sección sigue en construcción.</p>
    </div>
  </div>
</section>

<script>
  // Sin esto los cubos reaparecerian siempre en las mismas 4 posiciones
  function randomizeCube(cube: HTMLElement) {
    cube.style.setProperty('--cube-top', `${Math.random() * 90}vh`);
    cube.style.setProperty('--cube-left', `${Math.random() * 90}vw`);
  }

  const cubes = document.querySelectorAll<HTMLElement>('.cubesFx .cube');
  cubes.forEach((cube) => {
    randomizeCube(cube);
    // Se reubica al cerrar cada vuelta, no en cada frame
    cube.addEventListener('animationiteration', () => randomizeCube(cube));
  });
</script>

<style>
  /* Capa fija detras del contenido: la animacion sigue visible al hacer scroll */
  .cubesFx {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .projectsHero {
    position: relative;
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1em;
  }
  .heroContent {
    position: relative;
    z-index: 1;
  }
  /* Etiqueta que deja claro que el contenido no es definitivo */
  .devBadge {
    display: inline-block;
    margin-bottom: 1em;
    padding: 0.25em 1em;
    border: 1px solid var(--color-highlight);
    border-radius: 999px;
    color: var(--color-highlight);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .devNotice {
    display: flex;
    gap: 1em;
    align-items: flex-start;
    margin-bottom: 2.5em;
    padding: 1.25em 1.5em;
    border: 1px dashed var(--color-highlight);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-highlight) 8%, transparent);
  }
  .devNoticeIcon {
    color: var(--color-highlight);
    font-size: 22px;
    line-height: 1.2;
  }
  .devNotice strong {
    color: var(--color-ink);
  }
  .devNotice p {
    margin: 0.25em 0 0 0;
    font-size: 15px;
    line-height: 1.5;
  }
  .projectsHero h1 {
    color: var(--color-highlight);
    font-size: 55px;
  }
  .cube {
    position: absolute;
    top: var(--cube-top, 80vh);
    left: var(--cube-left, 45vw);
    width: 10px;
    height: 10px;
    border: solid 1px var(--color-highlight-deep);
    transform-origin: top left;
    transform: scale(0) rotate(0deg) translate(-50%, -50%);
    animation: cube 6s ease-in infinite;
  }
  .cube:nth-child(2n) {
    border-color: var(--color-highlight);
  }
  .cube:nth-child(2) {
    animation-delay: 1s;
  }
  .cube:nth-child(3) {
    animation-delay: 2s;
  }
  .cube:nth-child(4) {
    animation-delay: 3s;
  }
  .cube:nth-child(5) {
    animation-delay: 4s;
  }
  .cube:nth-child(6) {
    animation-delay: 5s;
  }
  @keyframes cube {
    from {
      transform: scale(0) rotate(0deg) translate(-50%, -50%);
      opacity: 1;
    }
    to {
      transform: scale(20) rotate(960deg) translate(-50%, -50%);
      opacity: 0;
    }
  }
  .line {
    height: 3px;
    width: 120px;
    background-color: var(--color-highlight);
    border-radius: 2px;
    margin: 0.5em auto;
  }
  .comment {
    color: var(--color-highlight);
    font-size: 16px;
    margin: 0;
  }
  .scrollCue {
    margin-top: 3em;
    color: var(--color-ink-muted);
    font-size: 14px;
  }
  .scrollCue span {
    display: block;
    animation: bounce 1.6s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
  .projectsZone {
    width: 1000px;
    max-width: calc(100% - 2em);
    margin: 2em auto;
    padding: 1em;
  }
  .projectsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5em;
  }
  .projectCard {
    display: block;
    text-decoration: none;
    color: var(--color-ink-muted);
    background: var(--color-bg-elevated);
    border-radius: 10px;
    padding: 1.5em;
    box-shadow: var(--shadow-elevated);
    transition: transform 0.2s ease;
  }
  .projectCard:hover {
    transform: translateY(-4px);
  }
  .projectCard h3 {
    color: var(--color-ink);
    margin-bottom: 0.5em;
  }
  .status {
    display: inline-block;
    font-size: 12px;
    color: var(--color-highlight);
    border: 1px solid var(--color-highlight);
    border-radius: 999px;
    padding: 0.15em 0.7em;
    margin-bottom: 0.75em;
  }
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    padding: 0;
    margin: 1em 0 0 0;
  }
  .stack li {
    font-size: 12px;
    color: var(--color-highlight-deep);
    background: color-mix(in srgb, var(--color-highlight-deep) 15%, transparent);
    border-radius: 6px;
    padding: 0.2em 0.6em;
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    border: 1px dashed var(--color-ink-muted);
    background: transparent;
    box-shadow: none;
  }
</style>
