---
const projects = [
  {
    title: 'Landing Page Portfolio',
    description: 'Sitio personal construido con Astro: blog, RSS y este mismo apartado de proyectos.',
    stack: ['Astro', 'TypeScript', 'MDX'],
    status: 'En desarrollo',
    href: 'https://github.com/TheGamer406',
  },
];
---

<div class="projectsHero">
  <h1>Proyectos</h1>
  <div class="line" />
  <p class="comment">Trabajo en curso &middot; se irán agregando proyectos aquí</p>
  <p class="scrollCue">Desliza para ver <span>&darr;</span></p>
</div>

<section class="projectsZone">

  <div class="projectsGrid">
    {projects.map((project) => (
      <a class="projectCard" href={project.href} target="_blank" rel="noopener noreferrer">
        <span class="status">{project.status}</span>
        <h3>{project.title}</h3>
        <p>{project.description}</p>
        <ul class="stack">
          {project.stack.map((tech) => <li>{tech}</li>)}
        </ul>
      </a>
    ))}

    <div class="projectCard placeholder">
      <span class="status">Próximamente</span>
      <h3>Más proyectos en camino</h3>
      <p>Esta sección sigue en construcción.</p>
    </div>
  </div>
</section>

<style>
  .projectsHero {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1em;
  }
  .projectsHero h1 {
    color: var(--color-highlight);
    font-size: 55px;
  }
  .line {
    height: 3px;
    width: 120px;
    background-color: var(--color-highlight);
    border-radius: 2px;
    margin: 0.5em auto;
  }
  .comment {
    color: var(--color-highlight);
    font-size: 16px;
    margin: 0;
  }
  .scrollCue {
    margin-top: 3em;
    color: var(--color-ink-muted);
    font-size: 14px;
  }
  .scrollCue span {
    display: block;
    animation: bounce 1.6s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(8px); }
  }
  .projectsZone {
    width: 1000px;
    max-width: calc(100% - 2em);
    margin: 2em auto;
    padding: 1em;
  }
  .projectsGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5em;
  }
  .projectCard {
    display: block;
    text-decoration: none;
    color: var(--color-ink-muted);
    background: var(--color-bg-elevated);
    border-radius: 10px;
    padding: 1.5em;
    box-shadow: var(--shadow-elevated);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .projectCard:hover {
    transform: translateY(-4px);
  }
  .projectCard h3 {
    color: var(--color-ink);
    margin-bottom: 0.5em;
  }
  .status {
    display: inline-block;
    font-size: 12px;
    color: var(--color-highlight);
    border: 1px solid var(--color-highlight);
    border-radius: 999px;
    padding: 0.15em 0.7em;
    margin-bottom: 0.75em;
  }
  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    padding: 0;
    margin: 1em 0 0 0;
  }
  .stack li {
    font-size: 12px;
    color: var(--color-highlight-deep);
    background: color-mix(in srgb, var(--color-highlight-deep) 15%, transparent);
    border-radius: 6px;
    padding: 0.2em 0.6em;
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    border: 1px dashed var(--color-ink-muted);
    background: transparent;
    box-shadow: none;
  }
</style>
