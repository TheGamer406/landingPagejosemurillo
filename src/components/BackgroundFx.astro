<!--fondo decorativo, no aporta contenido-->
<div class="bgFx" aria-hidden="true">
  <div class="bgPattern"></div>
</div>

<style>
  /* Capa fija detras de todo el contenido */
  .bgFx {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }
  /* --sx/--sy = tamaño real del tile (fancy-pants.jpg) para que el bucle no tenga costura.
     El inset negativo sobresale del viewport para cubrir el desplazamiento maximo (760px). */
  .bgPattern {
    position: absolute;
    inset: -800px;
    --sx: 760px;
    --sy: 380px;
    background: url('/fancy-pants.jpg') repeat;
    background-size: var(--sx) var(--sy);
    opacity: 0.35;
    will-change: transform;
    animation: bgDrift 90s linear infinite;
  }
  /* Se anima transform (GPU) y no background-position, que repinta y se ve a saltos */
  @keyframes bgDrift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(var(--sx), var(--sy), 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bgPattern {
      animation: none;
    }
  }
</style>
