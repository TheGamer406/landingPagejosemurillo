---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<script>
  const header = document.querySelector('header');
  const THRESHOLD = 40;
  let ticking = false;

  function updateHeader(){
    header?.classList.toggle('is-visible', window.scrollY > THRESHOLD);
    ticking = false;
  }

  document.addEventListener('scroll', () => {
    if(!ticking){
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  },{passive: true});

  updateHeader();
</script>
<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
      <HeaderLink href="/">Inicio</HeaderLink>
        <HeaderLink href="/projects">Proyectos</HeaderLink>
          <HeaderLink href="/contact">contacto</HeaderLink>
		</div>
		<!--cada icono revela su etiqueta al pasar el cursor-->
		<div class="social-links">
			<a class="iconLink" href="https://www.linkedin.com/in/josemurilloch" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Ir al LinkedIn de Jose</span>
				<svg viewBox="0 0 448 512" aria-hidden="true" width="26" height="26"
					><path
						fill="currentColor"
						d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
					></path></svg
				>
				<span class="tip">LinkedIn</span>
			</a>

			<a class="iconLink" href="https://github.com/TheGamer406" target="_blank" rel="noopener noreferrer">
				<span class="sr-only">Ir al GitHub de Jose</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="26" height="26"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
				<span class="tip">GitHub</span>
			</a>

			<a class="iconLink" href="mailto:contacto@jmurilloch.dev">
				<span class="sr-only">Enviar correo a contacto@jmurilloch.dev</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="26" height="26"
					><path
						fill="currentColor"
						d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.24-8 4.76-8-4.76V6l8 4.76L20 6v2.24z"
					></path></svg
				>
				<span class="tip">contacto@jmurilloch.dev</span>
			</a>
		</div>
	</nav>
</header>
<style>
  header {
    height: 0;
    z-index: 20;
    margin: 0;
    padding: 0 1em;
    background: var(--color-bg-elevated);
    box-shadow: 0 2px 8px rgba(0,0,0,20%);
    position: sticky;
    top: 0;
    opacity: 0;
    transform: translateY(0);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  header.is-visible{
    height: auto;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--color-ink);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--color-accent);
	}
	.social-links {
		display: flex;
		align-items: center;
		gap: 1.25em;
	}
	.iconLink {
		position: relative;
		display: flex;
		padding: 0;
		border-bottom: none;
		color: var(--color-ink-muted);
		transition: color 0.2s ease;
	}
	.iconLink:hover,
	.iconLink:focus-visible {
		color: var(--color-highlight);
	}
	/* La etiqueta cae hacia abajo porque el header esta pegado al borde superior */
	.tip {
		position: absolute;
		top: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%);
		padding: 0.2em 0.7em;
		border-radius: 6px;
		background: var(--color-bg-elevated);
		color: var(--color-ink);
		box-shadow: var(--shadow-elevated);
		font-size: 13px;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}
	.iconLink:hover .tip,
	.iconLink:focus-visible .tip {
		opacity: 1;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.iconLink,
		.tip {
			transition: none;
		}
	}
</style>
