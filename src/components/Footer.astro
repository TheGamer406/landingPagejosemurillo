---
const today = new Date();
---

<footer>
  &copy; {today.getFullYear()} Jose Murillo.
	<div class="social-links">
		<!--cada icono revela su etiqueta al pasar el cursor-->
		<a class="iconLink" href="https://github.com/TheGamer406" target="_blank" rel="noopener noreferrer">
			<span class="sr-only">Ir al GitHub de Jose</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path></svg
			>
			<span class="tip">GitHub</span>
		</a>

		<a class="iconLink" href="mailto:contacto@jmurilloch.dev">
			<span class="sr-only">Enviar correo a contacto@jmurilloch.dev</span>
			<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"
				><path
					fill="currentColor"
					d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.24-8 4.76-8-4.76V6l8 4.76L20 6v2.24z"
				></path></svg
			>
			<span class="tip">contacto@jmurilloch.dev</span>
		</a>
	</div>

	<a class="contactBtn" href="/contact">Contactame</a>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--color-bg-gradient)) no-repeat;
		color: var(--color-ink-muted);
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1.5em;
		margin-top: 1em;
	}
	.iconLink {
		position: relative;
		display: inline-flex;
		text-decoration: none;
		color: var(--color-ink-muted);
		transition: color 0.2s ease, transform 0.2s ease;
	}
	.iconLink:hover,
	.iconLink:focus-visible {
		color: var(--color-highlight);
		transform: translateY(-2px);
	}
	/* Etiqueta flotante sobre el icono */
	.tip {
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		transform: translateX(-50%);
		padding: 0.2em 0.7em;
		border-radius: 6px;
		background: var(--color-bg-elevated);
		color: var(--color-ink);
		font-size: 13px;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}
	.iconLink:hover .tip,
	.iconLink:focus-visible .tip {
		opacity: 1;
	}
	.contactBtn {
		display: inline-block;
		margin-top: 1.5em;
		padding: 0.5em 1.5em;
		border: 1px solid var(--color-highlight);
		border-radius: 999px;
		color: var(--color-ink);
		text-decoration: none;
		font-size: 16px;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.contactBtn:hover,
	.contactBtn:focus-visible {
		background-color: var(--color-highlight);
		color: var(--color-bg-page);
	}
	@media (prefers-reduced-motion: reduce) {
		.iconLink,
		.contactBtn {
			transition: none;
		}
		.iconLink:hover,
		.iconLink:focus-visible {
			transform: none;
		}
	}
</style>
